<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'DownKyi.TestInfrastructure'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)TestInfrastructure\DownKyi.TestInfrastructure.csproj" />
    <Compile
      Include="$(MSBuildThisFileDirectory)TestInfrastructure\TestDataIsolationRegistration.cs"
      Link="TestInfrastructure\TestDataIsolationRegistration.cs" />
  </ItemGroup>

  <Target
    Name="ValidateDownKyiTestPlatformOwnership"
    BeforeTargets="PrepareForBuild"
    Condition="'$(MSBuildProjectName)' != 'DownKyi.TestInfrastructure'">
    <Error
      Condition="'$(DownKyiTestPlatform)' == ''"
      Text="Test project $(MSBuildProjectName) must declare DownKyiTestPlatform." />
    <Error
      Condition="'$(DownKyiTestPlatform)' != '' and '$(DownKyiTestPlatform)' != 'cross-platform' and '$(DownKyiTestPlatform)' != 'windows' and '$(DownKyiTestPlatform)' != 'linux' and '$(DownKyiTestPlatform)' != 'macos'"
      Text="Test project $(MSBuildProjectName) has unsupported DownKyiTestPlatform '$(DownKyiTestPlatform)'." />
  </Target>

</Project>
