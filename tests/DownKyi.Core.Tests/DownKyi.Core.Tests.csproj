  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownKyi.Application\DownKyi.Application.csproj" />
    <ProjectReference Include="..\..\src\DownKyi.Core\DownKyi.Core.csproj" />
    <ProjectReference Include="..\..\src\DownKyi.Infrastructure\DownKyi.Infrastructure.csproj" />
    <ProjectReference Include="..\TestInfrastructure\DownKyi.TestInfrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BiliApi\JsonSamples\space-publication-search.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="BiliApi\JsonSamples\space-dynamic-feed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
