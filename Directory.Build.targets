<Project>
  <ItemGroup Condition="'$(DownKyiTestPlatforms)' != ''">
    <Compile
      Include="$(MSBuildThisFileDirectory)tests\CentralTestExecutionGuard.cs"
      Link="DownKyi.TestInfrastructure\CentralTestExecutionGuard.cs" />
  </ItemGroup>

  <Target
    Name="EnforceDownKyiCentralTestRunner"
    BeforeTargets="VSTest"
    Condition="'$(IsTestProject)' == 'true'">
    <Error Text="VSTest execution is disabled for repository test projects; use script/test-project-runner.ps1." />
  </Target>
</Project>
