    <system:String x:Key="DownloadHistoryEmptyTitle">No downloads completed yet</system:String>
    <system:String x:Key="DownloadHistoryEmptyHint">Completed downloads appear here for playback, opening their folder, and managing records.</system:String>
    <system:String x:Key="Downloading">Downloading</system:String>
    <system:String x:Key="DownloadFinished">Downloaded</system:String>
    <system:String x:Key="DownloadSuccess">Download completed</system:String>
    <system:String x:Key="DownloadingAudio">Audio</system:String>
    <system:String x:Key="DownloadingVideo">Video</system:String>
    <system:String x:Key="DownloadingDanmaku">Danmaku</system:String>
    <system:String x:Key="DownloadingSubtitle">Subtitle</system:String>
    <system:String x:Key="DownloadingCover">Cover image</system:String>
    <system:String x:Key="Parsing">Parsing...</system:String>
    <system:String x:Key="WhileDownloading">Downloading...</system:String>
    <system:String x:Key="MixedFlow">Muxing streams…</system:String>
    <system:String x:Key="ConcatVideos">Joining video segments…</system:String>
    <system:String x:Key="Pausing">Pausing...</system:String>
    <system:String x:Key="Paused">Paused</system:String>
    <system:String x:Key="Waiting">Waiting…</system:String>
    <system:String x:Key="DownloadFailed">Download failed</system:String>
    <system:String x:Key="DownloadFailureDetails">View reason</system:String>
    <system:String x:Key="HideFailureDetails">Hide reason</system:String>
    <system:String x:Key="DownloadFailureCode">Error code</system:String>
    <system:String x:Key="DownloadFailureUnknownCode">Unknown</system:String>
    <system:String x:Key="DownloadFailureUnavailableDetails">The requested video quality, audio track, or other content is unavailable. Parse the video again and create a new task using available content. Retrying will not change the original task's choices.</system:String>
    <system:String x:Key="DownloadFailureRateLimitDetails">The server is temporarily limiting requests. Wait before selecting Retry, and avoid repeated submissions.</system:String>
    <system:String x:Key="DownloadFailureAccessDetails">The server rejected the download request. Check your sign-in status and access rights. If it keeps failing, parse the video again and select another quality.</system:String>
    <system:String x:Key="DownloadFailureCoverAccessDetails">The server rejected the cover image request. Try again later. If it keeps failing, create a new task or deselect the cover image.</system:String>
    <system:String x:Key="DownloadFailureArtifactAccessDetails">The server rejected an additional file request. Check your sign-in status and access rights, then retry. If it keeps failing, create a new task or deselect that file.</system:String>
    <system:String x:Key="DownloadFailureExpiredAddressDetails">The download URL expired or the server rejected it. DownKyi already tried switching and refreshing URLs. Parse the video again and create a new task. If it keeps failing, check your sign-in status and access rights.</system:String>
    <system:String x:Key="DownloadFailureNetworkDetails">The network connection or server response was interrupted. Check your network and proxy settings, then select Retry.</system:String>
    <system:String x:Key="DownloadFailureStorageDetails">A local download file could not be written or cleaned up, or it conflicts with an existing file. Check folder permissions, free space, and files with the same name, then select Retry.</system:String>
    <system:String x:Key="DownloadFailureInvalidOutputDetails">The downloaded file failed an integrity check. Select Retry. If the same content keeps failing, parse it again and try another quality.</system:String>
    <system:String x:Key="DownloadFailureSubtitleDetails">The selected subtitle could not be downloaded. Select Retry. If it is no longer available, create a new task with another subtitle selection.</system:String>
    <system:String x:Key="DownloadFailureArtifactDetails">An additional file could not be downloaded. Check the network and download folder, then retry. If it keeps failing, export a diagnostic package from Settings → About &amp; Feedback.</system:String>
    <system:String x:Key="DownloadFailureProcessingDetails">Processing after download did not finish. Select Retry. If it keeps failing, export a diagnostic package from Settings → About &amp; Feedback.</system:String>
    <system:String x:Key="DownloadFailureTlsDetails">Secure connection verification failed. Please check the system date, proxy and certificate settings and try again.</system:String>
    <system:String x:Key="DownloadFailureRuntimeDetails">The download service cannot continue. Restart DownKyi. If it still fails, export a diagnostic package from Settings → About &amp; Feedback.</system:String>
    <system:String x:Key="DownloadFailureLegacyDetails">This task uses a retired downloader and cannot be retried directly. Parse the video again and create a new task.</system:String>
    <system:String x:Key="DownloadFailurePublicationRecoveryDetails">The previous output file’s final state cannot be confirmed safely, so this task cannot be retried directly. Check for a file with the same name, delete this failed task, then parse the video again and create a new task.</system:String>
    <system:String x:Key="DownloadFailurePublishedArtifactDetails">A finalized download file is missing or damaged, so the original task cannot be retried directly. Move or delete any damaged file with the same name, delete this failed task, then parse the video again and create a new task.</system:String>
    <system:String x:Key="DownloadFailureGenericDetails">The cause is not yet known. Select Retry. If it fails again, export a diagnostic package from Settings → About &amp; Feedback.</system:String>
    <system:String x:Key="SubtitleDownloadFailed">Subtitle download failed</system:String>
    <system:String x:Key="DownloadRuntimeUnavailable">The download service failed to start. Restart DownKyi and check the logs.</system:String>
    <system:String x:Key="TotalDownloading1">Downloading </system:String>
    <system:String x:Key="TotalDownloading2"> videos</system:String>
