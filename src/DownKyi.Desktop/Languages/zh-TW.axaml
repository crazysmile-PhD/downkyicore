<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--  App  -->
    <system:String x:Key="AppName">嗶哩下載姬</system:String>
    <system:String x:Key="Unknown">未知</system:String>
    <system:String x:Key="InterfaceLanguage">介面語言</system:String>
    <system:String x:Key="RestartToApplyLanguage">語言設定已儲存，請重新啟動 DownKyi 以套用。</system:String>
    <system:String x:Key="LanguageRestartHint">重新啟動程式後會套用所選語言。</system:String>

    <!--  系统  -->
    <system:String x:Key="Close">關閉</system:String>

    <!--  Index  -->
    <system:String x:Key="IndexPosterInputHint">貼上 B 站連結或 BV / av 號</system:String>
    <system:String x:Key="IndexParse">解析</system:String>
    <system:String x:Key="IndexCategory">影片下載工具</system:String>
    <system:String x:Key="Login">登入</system:String>
    <system:String x:Key="IndexHintText">請輸入B站網址連結或av、BV號等……</system:String>
    <system:String x:Key="IndexHintTextSimple">請輸入 Bilibili 影片網址……</system:String>
    <system:String x:Key="TipUnsupportedSearchInput">無法識別此輸入，請輸入B站連結或 av、BV、ss、ep、md、ml、uid 編號。</system:String>
    <system:String x:Key="Settings">設定</system:String>
    <system:String x:Key="DownloadManager">下載管理</system:String>
    <system:String x:Key="Toolbox">工具箱</system:String>

    <!--  Login  -->
    <system:String x:Key="LoginStudioHeadline" xml:space="preserve">登入&#x000A;你的空間</system:String>
    <system:String x:Key="LoginScannedConfirmation">已掃碼，請在手機上確認</system:String>
    <system:String x:Key="MigrationHeading">資料移轉</system:String>

    <system:String x:Key="ScanToLogin">掃描 QR Code 登入</system:String>
    <system:String x:Key="ScanLoginTip" xml:space="preserve">請使用 Bilibili App&#x000A;掃描 QR Code 登入&#x000A;或掃描 QR Code 下載 App</system:String>
    <system:String x:Key="GetLoginUrlFailed">無法取得登入連結！</system:String>
    <system:String x:Key="LoginKeyError">登入金鑰無效，請重新取得。</system:String>
    <system:String x:Key="LoginTimeOut">登入已逾時，請重新取得 QR Code。</system:String>
    <system:String x:Key="LoginSuccessful">登入成功，3 秒後將自動返回首頁。</system:String>
    <system:String x:Key="LoginFailed">無法儲存登入資訊，3 秒後將自動返回首頁。</system:String>
    <system:String x:Key="BrowserCookieLogin">使用瀏覽器 Cookie 登入</system:String>
