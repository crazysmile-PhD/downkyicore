    <system:String x:Key="DownloadedSortByTimeDesc">按下載時間降序</system:String>
    <system:String x:Key="DownloadedSortByOrder">按序號排序</system:String>
    <system:String x:Key="ClearAllDownloaded">清除所有紀錄</system:String>
