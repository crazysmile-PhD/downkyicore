    <system:String x:Key="Duration">時長</system:String>
    <system:String x:Key="SelectAll">全選</system:String>
    <system:String x:Key="ClearSelection">清除選取</system:String>
    <system:String x:Key="Search">搜尋</system:String>
    <system:String x:Key="SearchVideoByName">搜尋影片名稱</system:String>
    <system:String x:Key="VideoDetailStatusLoading">正在讀取影片資訊……</system:String>
    <system:String x:Key="VideoDetailStatusLoaded">影片資訊已載入，可選擇內容並下載。</system:String>
    <system:String x:Key="VideoDetailStatusNoContent">沒有找到可解析的影片內容。</system:String>
    <system:String x:Key="VideoDetailStatusCanceled">操作已取消。</system:String>
    <system:String x:Key="VideoDetailStatusFailed">操作失敗，請檢視日誌。</system:String>
    <system:String x:Key="VideoDetailStatusAddingDownloads">正在建立下載任務……</system:String>
    <system:String x:Key="VideoDetailStatusAddUnavailable">未能建立下載任務；下載服務沒有返回結果。</system:String>
    <system:String x:Key="DownloadSelected">下載所選項目</system:String>
    <system:String x:Key="AddAllToDownload">下載全部</system:String>
    <system:String x:Key="TipAlreadyToAddDownloading">此內容已加入下載佇列，無需重複新增。</system:String>
    <system:String x:Key="TipAlreadyToAddDownloaded">此內容已下載完成。</system:String>
    <system:String x:Key="TipAddDownloadingZero">沒有符合下載條件的選取項目。</system:String>
    <system:String x:Key="TipAddDownloadingUnavailable">所選內容目前沒有可下載的資源。</system:String>
    <system:String x:Key="TipAddDownloadingSkippedByChoice">已按你的選擇跳過下載。</system:String>
    <system:String x:Key="TipAddDownloadingFailed">新增下載任務失敗。</system:String>
    <system:String x:Key="TipAddDownloadingUnsupportedInput">目前的輸入無法建立下載任務。</system:String>
    <system:String x:Key="TipAddDownloadingCanceled">已取消新增下載任務。</system:String>
    <system:String x:Key="TipAddDownloadingCanceledAfterProgress">{0}（後續新增已取消。）</system:String>
    <system:String x:Key="TipAddDownloadingSelectionUnavailable">下載目錄不可用，未新增任務。</system:String>
    <system:String x:Key="TipAddDownloadingSummary">新增 {0} 項；重複 {1} 項，跳過 {2} 項，失敗 {3} 項。</system:String>
    <system:String x:Key="TipAddDownloadingNoAddedSummary">未新增任務；重複 {0} 項，跳過 {1} 項，失敗 {2} 項。</system:String>
    <system:String x:Key="TipAddDownloadingFinished1">已新增 </system:String>
    <system:String x:Key="TipAddDownloadingFinished2"> 項</system:String>
    <system:String x:Key="TipAddDownloadingFinishedWithSkipped">已新增 {0} 項，並跳過 {1} 個無法下載的項目。</system:String>
    <system:String x:Key="TipAddDownloadingSkipped">已跳過 {1} 個無法下載的項目，沒有新增下載任務。</system:String>

    <!--  DownloadManager  -->
    <system:String x:Key="DownloadTaskColumn">影片與規格</system:String>
    <system:String x:Key="DownloadTransferColumn">進度 / 傳輸</system:String>
    <system:String x:Key="DownloadCompletedColumn">完成時間</system:String>
    <system:String x:Key="DownloadActionsColumn">操作</system:String>
    <system:String x:Key="DownloadQueueLabel">佇列</system:String>
    <system:String x:Key="DownloadCompletedLabel">已完成</system:String>
    <system:String x:Key="DownloadTaskUnit">項</system:String>
    <system:String x:Key="DownloadQueueEmptyTitle">佇列為空</system:String>
    <system:String x:Key="DownloadQueueEmptyHint">下載完成的任務會移到右上角「已下載」。若剛剛新增了影片，請在那裡檢視或開啟檔案。</system:String>
    <system:String x:Key="DownloadHistoryEmptyTitle">尚無已完成的下載</system:String>
    <system:String x:Key="DownloadHistoryEmptyHint">下載完成後，可以在這裡播放影片、開啟資料夾或整理記錄。</system:String>
    <system:String x:Key="Downloading">正在下載</system:String>
    <system:String x:Key="DownloadFinished">已下載</system:String>
    <system:String x:Key="DownloadSuccess">下載完成</system:String>
    <system:String x:Key="DownloadingAudio">音訊</system:String>
    <system:String x:Key="DownloadingVideo">影片</system:String>
    <system:String x:Key="DownloadingDanmaku">彈幕</system:String>
    <system:String x:Key="DownloadingSubtitle">字幕</system:String>
    <system:String x:Key="DownloadingCover">封面</system:String>
    <system:String x:Key="Parsing">正在解析……</system:String>
    <system:String x:Key="WhileDownloading">下載中……</system:String>
    <system:String x:Key="MixedFlow">混流中……</system:String>
    <system:String x:Key="ConcatVideos">影片合併中……</system:String>
    <system:String x:Key="Pausing">暫停中……</system:String>
    <system:String x:Key="Paused">已暫停</system:String>
    <system:String x:Key="Waiting">等待中……</system:String>
    <system:String x:Key="DownloadFailed">下載失敗</system:String>
    <system:String x:Key="DownloadFailureDetails">檢視原因</system:String>
    <system:String x:Key="HideFailureDetails">收起原因</system:String>
    <system:String x:Key="DownloadFailureCode">錯誤代碼</system:String>
    <system:String x:Key="DownloadFailureUnknownCode">未知</system:String>
    <system:String x:Key="DownloadFailureUnavailableDetails">所要求的畫質、音軌或其他內容目前無法取得。請重新解析影片並建立新任務，選擇目前可用的內容；重試不會變更原任務的選擇。</system:String>
    <system:String x:Key="DownloadFailureRateLimitDetails">伺服器暫時限制請求。請稍後再按「重試」，避免連續送出請求。</system:String>
    <system:String x:Key="DownloadFailureAccessDetails">伺服器拒絕下載請求。請檢查登入狀態及內容存取權限；若持續失敗，請重新解析影片並選擇其他畫質。</system:String>
    <system:String x:Key="DownloadFailureCoverAccessDetails">伺服器拒絕封面圖片請求。請稍後重試；若持續失敗，請建立新任務或取消封面圖片選項。</system:String>
    <system:String x:Key="DownloadFailureArtifactAccessDetails">伺服器拒絕附加檔案請求。請檢查登入狀態及內容存取權限後重試；若持續失敗，請建立新任務或取消對應的附加檔案選項。</system:String>
    <system:String x:Key="DownloadFailureExpiredAddressDetails">下載網址已失效或遭伺服器拒絕。程式已嘗試切換並更新網址；請重新解析影片並建立新任務。若持續失敗，請檢查登入狀態及內容存取權限。</system:String>
    <system:String x:Key="DownloadFailureNetworkDetails">網路連線或伺服器回應中斷。請檢查網路及代理設定，再按「重試」。</system:String>
    <system:String x:Key="DownloadFailureStorageDetails">本機下載檔案無法寫入或清理，或與現有檔案衝突。請檢查下載目錄權限、剩餘空間與同名檔案，再按「重試」。</system:String>
    <system:String x:Key="DownloadFailureInvalidOutputDetails">下載檔案未通過完整性檢查。可按「重試」；若同一內容持續失敗，請重新解析影片並嘗試其他畫質。</system:String>
    <system:String x:Key="DownloadFailureSubtitleDetails">所選字幕未能完成下載。可按「重試」；若字幕已無法取得，請建立新任務並調整字幕選擇。</system:String>
    <system:String x:Key="DownloadFailureArtifactDetails">附加檔案未能完成下載。請檢查網路及下載目錄後重試；若持續失敗，可至「設定 → 關於與回饋」匯出診斷包。</system:String>
    <system:String x:Key="DownloadFailureProcessingDetails">下載後的檔案處理未完成。可按「重試」；若持續失敗，可至「設定 → 關於與回饋」匯出診斷包。</system:String>
    <system:String x:Key="DownloadFailureCoverConversionDetails">封面無法轉換為 MP4 可寫入的格式。重試同一工作不會改變結果；請取消「封面」後重新建立工作，並至「設定 → 關於與回饋」匯出診斷包。</system:String>
    <system:String x:Key="DownloadFailureTlsDetails">安全連線驗證失敗。請檢查系統日期、代理及憑證設定，再重試。</system:String>
    <system:String x:Key="DownloadFailureRuntimeDetails">下載服務無法繼續執行。請重新啟動程式；若仍失敗，可至「設定 → 關於與回饋」匯出診斷包。</system:String>
    <system:String x:Key="DownloadFailureLegacyDetails">此任務使用已移除的舊下載器，無法直接重試。請重新解析並建立任務。</system:String>
    <system:String x:Key="DownloadFailurePublicationRecoveryDetails">無法安全確認上次下載檔案是否已完成輸出，因此無法直接重試此任務。請檢查是否有同名檔案，刪除此失敗任務後，重新解析影片並建立新任務。</system:String>
    <system:String x:Key="DownloadFailurePublishedArtifactDetails">已完成輸出的下載檔案遺失或損壞，原任務無法直接重試。若仍有同名的損壞檔案，請先移走或刪除；再刪除此失敗任務，重新解析影片並建立新任務。</system:String>
    <system:String x:Key="DownloadFailureGenericDetails">目前無法判斷確切原因。可按「重試」；若再次失敗，請至「設定 → 關於與回饋」匯出診斷包。</system:String>
    <system:String x:Key="SubtitleDownloadFailed">字幕下載失敗</system:String>
    <system:String x:Key="DownloadRuntimeUnavailable">下載服務啟動失敗。請重新啟動程式並查看日誌。</system:String>
    <system:String x:Key="TotalDownloading1">正在下載</system:String>
    <system:String x:Key="TotalDownloading2"> 部影片！</system:String>
