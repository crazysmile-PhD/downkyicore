    <system:String x:Key="CancelDownloadPreparation">取消準備</system:String>
    <system:String x:Key="TipDownloadPreparationAlreadyRunning">目前正在準備下載。請先取消準備，再重新選擇加入方式。</system:String>
    <system:String x:Key="PublicationWait">請稍候…</system:String>
    <system:String x:Key="DiscoveringCollectionVideos">正在尋找合集影片 {0}/{1}</system:String>
    <system:String x:Key="PreparingCollectionDownloads">已找到 {0} 部影片，正在準備下載</system:String>
    <system:String x:Key="PreparingCollectionDownloadItems">正在準備下載項目 {0}/{1}</system:String>

    <!--  Friend  -->
