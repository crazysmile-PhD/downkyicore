<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--  App  -->
    <system:String x:Key="AppName">DownKyi</system:String>
    <system:String x:Key="Unknown">不明</system:String>
    <system:String x:Key="InterfaceLanguage">表示言語</system:String>
    <system:String x:Key="RestartToApplyLanguage">言語設定を保存しました。反映するには DownKyi を再起動してください。</system:String>
    <system:String x:Key="LanguageRestartHint">選択した言語は再起動後に反映されます。</system:String>

    <!--  系统  -->
    <system:String x:Key="Close">閉じる</system:String>

    <!--  Index  -->
    <system:String x:Key="IndexPosterInputHint">Bilibili のリンクまたは BV/av 番号を貼り付け</system:String>
    <system:String x:Key="IndexParse">解析</system:String>
    <system:String x:Key="IndexCategory">動画ダウンロードツール</system:String>
    <system:String x:Key="Login">ログイン</system:String>
    <system:String x:Key="IndexHintText">Bilibili の URL または av/BV 番号を入力…</system:String>
    <system:String x:Key="IndexHintTextSimple">Bilibili 動画の URL を入力…</system:String>
    <system:String x:Key="TipUnsupportedSearchInput">入力を認識できません。Bilibili のリンク、または av、BV、ss、ep、md、ml、uid 番号を入力してください。</system:String>
    <system:String x:Key="Settings">設定</system:String>
    <system:String x:Key="DownloadManager">ダウンロード管理</system:String>
    <system:String x:Key="Toolbox">ツールボックス</system:String>

    <!--  Login  -->
    <system:String x:Key="LoginStudioHeadline" xml:space="preserve">ログインして&#x000A;マイスペースへ</system:String>
    <system:String x:Key="LoginScannedConfirmation">コードがスキャンされました。携帯電話で確認してください</system:String>
    <system:String x:Key="MigrationHeading">データ移行</system:String>

    <system:String x:Key="ScanToLogin">QR コードをスキャンしてログイン</system:String>
    <system:String x:Key="ScanLoginTip" xml:space="preserve">Bilibili アプリで QR コードを読み取ってログインするか、アプリをダウンロードしてください。</system:String>
    <system:String x:Key="GetLoginUrlFailed">ログイン URL を取得できませんでした。</system:String>
    <system:String x:Key="LoginKeyError">ログインキーが無効です。再取得してください。</system:String>
    <system:String x:Key="LoginTimeOut">ログインがタイムアウトしました。QR コードを再取得してください。</system:String>
    <system:String x:Key="LoginSuccessful">ログインしました。3 秒後にホームへ戻ります。</system:String>
    <system:String x:Key="LoginFailed">ログイン情報を保存できませんでした。3 秒後にホームへ戻ります。</system:String>
    <system:String x:Key="BrowserCookieLogin">ブラウザーの Cookie でログイン</system:String>
    <system:String x:Key="BrowserCookieWatermark">ブラウザーの Cookie ヘッダーを貼り付け</system:String>
    <system:String x:Key="BrowserCookieInvalid">有効なブラウザー Cookie が見つかりません</system:String>

    <!--  MySpace  -->
    <system:String x:Key="PersonalLibrary">マイコンテンツ</system:String>
    <system:String x:Key="PersonalSpaceHeadline">マイスペース</system:String>
    <system:String x:Key="PersonalCoinBalance">コイン</system:String>
    <system:String x:Key="PersonalMoneyBalance">B コイン</system:String>
    <system:String x:Key="PersonalEmailBound">メールアドレス連携済み</system:String>
    <system:String x:Key="PersonalPhoneBound">電話番号連携済み</system:String>
    <system:String x:Key="MySpace">マイスペース</system:String><system:String x:Key="Logout">ログアウト</system:String>
    <system:String x:Key="BilibiliDynamics">Bilibili の投稿</system:String>
    <system:String x:Key="MySpaceWait">しばらくお待ちください…</system:String>
    <system:String x:Key="Level">レベル</system:String>
    <system:String x:Key="Following">フォロー中</system:String>
    <system:String x:Key="Follower">フォロワー</system:String>
    <system:String x:Key="Black">ブロック数</system:String>
    <system:String x:Key="Moral">モラル値</system:String>
    <system:String x:Key="Silence">アカウントの停止状態</system:String>
    <system:String x:Key="Favorites">お気に入り</system:String>
    <system:String x:Key="Subscription">フォロー中の番組</system:String>
    <system:String x:Key="ToView">あとで見る</system:String>
    <system:String x:Key="History">視聴履歴</system:String>
    <system:String x:Key="Normal">正常</system:String>
    <system:String x:Key="Ban">利用停止</system:String>

    <!--  UserSpace  -->
    <system:String x:Key="UserSpace">ユーザースペース</system:String>
    <system:String x:Key="Followed">フォロー中</system:String>
    <system:String x:Key="NotFollowed">未フォロー</system:String>
    <system:String x:Key="FollowingCount">フォロー中</system:String>
    <system:String x:Key="FollowerCount">フォロワー</system:String>
    <system:String x:Key="LikesCount">いいね数</system:String>
    <system:String x:Key="ArchiveViewCount">動画の再生回数</system:String>
    <system:String x:Key="ArticleViewCount">記事の閲覧回数</system:String>
    <system:String x:Key="AllPublicationZones">すべて</system:String>
    <system:String x:Key="Publication">投稿動画</system:String>
    <system:String x:Key="DynamicVideos">タイムラインの動画</system:String>
    <system:String x:Key="Channel">チャンネル</system:String>
    <system:String x:Key="SeasonsSeries">コレクションとシリーズ</system:String>
    <system:String x:Key="UserSpaceWait">しばらくお待ちください…</system:String>

    <!--  PublicFavorites  -->
    <system:String x:Key="PublicFavorites">お気に入り</system:String>
    <system:String x:Key="FavoritesMediaCount">件</system:String>

    <!--  MyFavorites  -->
    <system:String x:Key="FavoritesPlayNumber">再生回数：</system:String>
    <system:String x:Key="FavoritesFavoriteNumber">お気に入り登録数：</system:String>
    <system:String x:Key="FavoritesUpName">投稿者：</system:String>
    <system:String x:Key="FavoritesCreateTime">投稿日時：</system:String>
    <system:String x:Key="FavoritesFavTime">登録日時：</system:String>

    <!--  MyBangumiFollow  -->
    <system:String x:Key="MyBangumiFollow">フォロー中の番組</system:String>
    <system:String x:Key="FollowAnime">アニメ</system:String>
    <system:String x:Key="FollowMovie">ドラマ</system:String>
    <system:String x:Key="BangumiNotWatched">未視聴</system:String>

    <!--  MyHistory  -->
    <system:String x:Key="MyHistory">視聴履歴</system:String>
    <system:String x:Key="HistoryFinished">視聴済み</system:String>
    <system:String x:Key="HistoryStarted">見始めたところ</system:String>
    <system:String x:Key="HistoryWatch">視聴位置</system:String>

    <!--  MyToView  -->
    <system:String x:Key="MyToView">あとで見る</system:String>

    <!--  Publication  -->
    <system:String x:Key="DownloadSelectedPublication">選択した動画をダウンロード</system:String>
    <system:String x:Key="DownloadAllPublication">すべてダウンロード</system:String>
    <system:String x:Key="PreparingDownloads">ダウンロードを準備中</system:String>
    <system:String x:Key="CancelDownloadPreparation">準備をキャンセル</system:String>
    <system:String x:Key="TipDownloadPreparationAlreadyRunning">ダウンロードの準備中です。追加方法を選び直すには、先に準備をキャンセルしてください。</system:String>
    <system:String x:Key="PublicationWait">しばらくお待ちください…</system:String>
    <system:String x:Key="DiscoveringCollectionVideos">合集の動画を検索中 {0}/{1}</system:String>
    <system:String x:Key="PreparingCollectionDownloads">{0} 本の動画が見つかりました。ダウンロードを準備中…</system:String>
    <system:String x:Key="PreparingCollectionDownloadItems">ダウンロード項目を準備中 {0}/{1}</system:String>

    <!--  Friend  -->
    <system:String x:Key="Friend">友達</system:String>
    <system:String x:Key="FriendFollowing">フォロー中</system:String>
    <system:String x:Key="FriendFollower">フォロワー</system:String>
    <system:String x:Key="FollowingWait">しばらくお待ちください…</system:String>
    <system:String x:Key="FollowerWait">しばらくお待ちください…</system:String>
    <system:String x:Key="AllFollowing">フォロー中のすべてのユーザー</system:String>

    <system:String x:Key="VideoDetailHeading">動画の解析</system:String>
    <system:String x:Key="DownloadOptionsHeading">ダウンロードオプション</system:String>
    <!--  VideoDetail  -->
    <system:String x:Key="CopyCoverUrl">サムネイルの URL をコピー</system:String>
    <system:String x:Key="Play">再生</system:String>
    <system:String x:Key="Danmaku">弾幕</system:String>
    <system:String x:Key="Like">いいね</system:String>
    <system:String x:Key="Coin">コイン</system:String>
    <system:String x:Key="Favorite">お気に入りに登録</system:String>
    <system:String x:Key="Share">共有</system:String>
    <system:String x:Key="Reply">コメント</system:String>
    <system:String x:Key="Anime">アニメ</system:String>
    <system:String x:Key="Movie">映画</system:String>
    <system:String x:Key="Documentary">ドキュメンタリー</system:String>
    <system:String x:Key="Guochuang">中国アニメ</system:String>
    <system:String x:Key="TV">テレビドラマ</system:String>
    <system:String x:Key="Entertainment">バラエティ番組</system:String>
    <system:String x:Key="Cheese">講座</system:String>
    <system:String x:Key="Order">番号</system:String>
    <system:String x:Key="Name">名前</system:String>
    <system:String x:Key="Duration">再生時間</system:String>
    <system:String x:Key="SelectAll">すべて選択</system:String>
    <system:String x:Key="ClearSelection">選択をクリア</system:String>
    <system:String x:Key="Search">検索</system:String>
    <system:String x:Key="SearchVideoByName">動画名を検索</system:String>
    <system:String x:Key="VideoDetailStatusLoading">動画情報を読み込み中…</system:String>
    <system:String x:Key="VideoDetailStatusLoaded">動画情報を読み込みました。ダウンロードする内容を選択してください。</system:String>
    <system:String x:Key="VideoDetailStatusNoContent">解析できる動画が見つかりませんでした。</system:String>
    <system:String x:Key="VideoDetailStatusCanceled">操作はキャンセルされました。</system:String>
    <system:String x:Key="VideoDetailStatusFailed">操作が失敗しました。ログを確認してください。</system:String>
    <system:String x:Key="VideoDetailStatusAddingDownloads">ダウンロードタスクを作成中…</system:String>
    <system:String x:Key="VideoDetailStatusAddUnavailable">ダウンロードサービスから結果が返らなかったため、タスクを作成できませんでした。</system:String>
    <system:String x:Key="DownloadSelected">選択した項目をダウンロード</system:String>
    <system:String x:Key="AddAllToDownload">すべてダウンロード</system:String>
    <system:String x:Key="TipAlreadyToAddDownloading">このコンテンツはすでにダウンロードキューにあります。</system:String>
    <system:String x:Key="TipAlreadyToAddDownloaded">ダウンロード済みです。</system:String>
    <system:String x:Key="TipAddDownloadingZero">ダウンロードできる項目が選択されていません。</system:String>
    <system:String x:Key="TipAddDownloadingUnavailable">選択したコンテンツには現在ダウンロード可能なファイルがありません。</system:String>
    <system:String x:Key="TipAddDownloadingSkippedByChoice">選択に従ってダウンロードをスキップしました。</system:String>
    <system:String x:Key="TipAddDownloadingFailed">ダウンロードタスクを追加できませんでした。</system:String>
    <system:String x:Key="TipAddDownloadingUnsupportedInput">この入力からダウンロードタスクを作成できません。</system:String>
    <system:String x:Key="TipAddDownloadingCanceled">ダウンロードタスクの追加をキャンセルしました。</system:String>
    <system:String x:Key="TipAddDownloadingCanceledAfterProgress">{0}（残りの追加はキャンセルされました。）</system:String>
    <system:String x:Key="TipAddDownloadingSelectionUnavailable">ダウンロード先のフォルダーを使用できないため、タスクは追加されませんでした。</system:String>
    <system:String x:Key="TipAddDownloadingSummary">追加 {0} 件、重複 {1} 件、スキップ {2} 件、失敗 {3} 件。</system:String>
    <system:String x:Key="TipAddDownloadingNoAddedSummary">タスクは追加されませんでした。重複 {0} 件、スキップ {1} 件、失敗 {2} 件。</system:String>
    <system:String x:Key="TipAddDownloadingFinished1">追加：</system:String>
    <system:String x:Key="TipAddDownloadingFinished2"> 件</system:String>
    <system:String x:Key="TipAddDownloadingFinishedWithSkipped">{0} 件を追加し、利用できない {1} 件をスキップしました。</system:String>
    <system:String x:Key="TipAddDownloadingSkipped">利用できない {1} 件をスキップしました。ダウンロードタスクは追加されませんでした。</system:String>

    <!--  DownloadManager  -->
    <system:String x:Key="DownloadTaskColumn">動画と形式</system:String>
    <system:String x:Key="DownloadTransferColumn">進捗 / 転送</system:String>
    <system:String x:Key="DownloadCompletedColumn">完了日時</system:String>
    <system:String x:Key="DownloadActionsColumn">操作</system:String>
    <system:String x:Key="DownloadQueueLabel">キュー</system:String>
    <system:String x:Key="DownloadCompletedLabel">完了</system:String>
    <system:String x:Key="DownloadTaskUnit">件</system:String>
    <system:String x:Key="DownloadQueueEmptyTitle">キューが空です</system:String>
    <system:String x:Key="DownloadQueueEmptyHint">完了したタスクは右上の「ダウンロード済み」に移動します。追加した動画はそこで確認したり、ファイルを開いたりできます。</system:String>
    <system:String x:Key="DownloadHistoryEmptyTitle">まだダウンロードは完了していません</system:String>
    <system:String x:Key="DownloadHistoryEmptyHint">ダウンロード完了後は、ここで動画の再生、フォルダーの表示、記録の整理ができます。</system:String>
    <system:String x:Key="Downloading">ダウンロード中</system:String>
    <system:String x:Key="DownloadFinished">ダウンロード済み</system:String>
    <system:String x:Key="DownloadSuccess">ダウンロード完了</system:String>
    <system:String x:Key="DownloadingAudio">オーディオ</system:String>
    <system:String x:Key="DownloadingVideo">動画</system:String>
    <system:String x:Key="DownloadingDanmaku">弾幕</system:String>
    <system:String x:Key="DownloadingSubtitle">字幕</system:String>
    <system:String x:Key="DownloadingCover">サムネイル</system:String>
    <system:String x:Key="Parsing">解析中...</system:String>
    <system:String x:Key="WhileDownloading">ダウンロード中...</system:String>
    <system:String x:Key="MixedFlow">音声と動画を結合中…</system:String>
    <system:String x:Key="ConcatVideos">動画を結合中…</system:String>
    <system:String x:Key="Pausing">一時停止中...</system:String>
    <system:String x:Key="Paused">一時停止中</system:String>
    <system:String x:Key="Waiting">待機中…</system:String>
    <system:String x:Key="DownloadFailed">ダウンロードに失敗しました</system:String>
    <system:String x:Key="DownloadFailureDetails">原因を表示</system:String>
    <system:String x:Key="HideFailureDetails">原因を非表示</system:String>
    <system:String x:Key="DownloadFailureCode">エラーコード</system:String>
    <system:String x:Key="DownloadFailureUnknownCode">不明</system:String>
    <system:String x:Key="DownloadFailureUnavailableDetails">要求された画質、音声トラック、その他のコンテンツは現在利用できません。動画を再解析し、利用可能な内容で新しいタスクを作成してください。再試行しても元のタスクの選択内容は変わりません。</system:String>
    <system:String x:Key="DownloadFailureRateLimitDetails">サーバーが一時的にリクエストを制限しています。しばらく待ってから「再試行」を押してください。連続して送信しないでください。</system:String>
    <system:String x:Key="DownloadFailureAccessDetails">サーバーがダウンロード要求を拒否しました。ログイン状態とコンテンツのアクセス権を確認してください。失敗が続く場合は、動画を再解析し、別の画質を選んでください。</system:String>
    <system:String x:Key="DownloadFailureCoverAccessDetails">サーバーがサムネイルの取得を拒否しました。しばらくしてから再試行してください。失敗が続く場合は、新しいタスクを作成するか、サムネイルの選択を解除してください。</system:String>
    <system:String x:Key="DownloadFailureArtifactAccessDetails">サーバーが追加ファイルの要求を拒否しました。ログイン状態とアクセス権を確認してから再試行してください。失敗が続く場合は、新しいタスクを作成するか、そのファイルの選択を解除してください。</system:String>
    <system:String x:Key="DownloadFailureExpiredAddressDetails">ダウンロード URL の有効期限が切れたか、サーバーに拒否されました。DownKyi は URL の切り替えと更新を試みました。動画を再解析して新しいタスクを作成してください。失敗が続く場合は、ログイン状態とアクセス権を確認してください。</system:String>
    <system:String x:Key="DownloadFailureNetworkDetails">ネットワーク接続またはサーバーの応答が中断されました。ネットワークとプロキシの設定を確認してから「再試行」を押してください。</system:String>
    <system:String x:Key="DownloadFailureStorageDetails">ローカルのダウンロードファイルを書き込めない、削除できない、または既存のファイルと競合しています。フォルダーの権限、空き容量、同名のファイルを確認してから「再試行」を押してください。</system:String>
    <system:String x:Key="DownloadFailureInvalidOutputDetails">ダウンロードしたファイルが整合性チェックに失敗しました。「再試行」を押してください。同じ内容で失敗が続く場合は、再解析して別の画質を試してください。</system:String>
    <system:String x:Key="DownloadFailureSubtitleDetails">選択した字幕をダウンロードできませんでした。「再試行」を押してください。字幕が利用できなくなった場合は、別の字幕を選んで新しいタスクを作成してください。</system:String>
    <system:String x:Key="DownloadFailureArtifactDetails">追加ファイルをダウンロードできませんでした。ネットワークとダウンロード先を確認してから再試行してください。失敗が続く場合は、「設定 → 概要とフィードバック」で診断パッケージをエクスポートしてください。</system:String>
    <system:String x:Key="DownloadFailureProcessingDetails">ダウンロード後のファイル処理が完了しませんでした。「再試行」を押してください。失敗が続く場合は、「設定 → 概要とフィードバック」で診断パッケージをエクスポートしてください。</system:String>
    <system:String x:Key="DownloadFailureTlsDetails">安全な接続の検証に失敗しました。システムの日付、プロキシ、および証明書の設定を確認して、再試行してください。</system:String>
    <system:String x:Key="DownloadFailureRuntimeDetails">ダウンロードサービスを続行できません。DownKyi を再起動してください。それでも失敗する場合は、「設定 → 概要とフィードバック」で診断パッケージをエクスポートしてください。</system:String>
    <system:String x:Key="DownloadFailureLegacyDetails">このタスクは廃止されたダウンローダーを使用しているため、直接再試行できません。動画を再解析して新しいタスクを作成してください。</system:String>
    <system:String x:Key="DownloadFailurePublicationRecoveryDetails">前回の出力ファイルが確定したかどうかを安全に確認できないため、このタスクは直接再試行できません。同名のファイルを確認し、失敗したタスクを削除してから、動画を再解析して新しいタスクを作成してください。</system:String>
    <system:String x:Key="DownloadFailurePublishedArtifactDetails">確定済みのダウンロードファイルが見つからないか破損しているため、元のタスクを直接再試行できません。同名の破損ファイルがあれば移動または削除し、失敗したタスクを削除してから、動画を再解析して新しいタスクを作成してください。</system:String>
    <system:String x:Key="DownloadFailureGenericDetails">原因を特定できません。「再試行」を押してください。再び失敗する場合は、「設定 → 概要とフィードバック」で診断パッケージをエクスポートしてください。</system:String>
    <system:String x:Key="SubtitleDownloadFailed">字幕のダウンロードに失敗しました</system:String>
    <system:String x:Key="DownloadRuntimeUnavailable">ダウンロードサービスを起動できませんでした。DownKyi を再起動し、ログを確認してください。</system:String>
    <system:String x:Key="TotalDownloading1">動画を </system:String>
    <system:String x:Key="TotalDownloading2"> 本ダウンロード中</system:String>
    <system:String x:Key="PauseAllDownloading">すべて一時停止する</system:String>
    <system:String x:Key="ContinueAllDownloading">すべて再開</system:String>
    <system:String x:Key="DeleteAllDownloading">すべて削除</system:String>
    <system:String x:Key="TotalDownloaded1">動画を </system:String>
    <system:String x:Key="TotalDownloaded2"> 本ダウンロード済み</system:String>
    <system:String x:Key="DownloadedSortByTimeAsc">ダウンロード日時の古い順</system:String>
    <system:String x:Key="DownloadedSortByTimeDesc">ダウンロード日時の新しい順</system:String>
    <system:String x:Key="DownloadedSortByOrder">番号順</system:String>
    <system:String x:Key="ClearAllDownloaded">すべての記録をクリアする</system:String>
