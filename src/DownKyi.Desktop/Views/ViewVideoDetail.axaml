<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DownKyi.Views"
             xmlns:vm="clr-namespace:DownKyi.ViewModels"
             x:Class="DownKyi.Views.ViewVideoDetail"
             x:DataType="vm:ViewVideoDetailViewModel"
             mc:Ignorable="d"
             d:DesignWidth="840"
             d:DesignHeight="620">
    <Grid RowDefinitions="50,10,*">
        <views:VideoDetailToolbarView Grid.Row="0" />

        <TextBlock Grid.Row="1" Opacity="0.3">
            <TextBlock.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="1" />
                </LinearGradientBrush>
            </TextBlock.Background>
        </TextBlock>

        <Grid Grid.Row="2"
              IsVisible="{Binding UiState.IsContentVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*" MaxHeight="180" />
                <RowDefinition Height="200*" />
            </Grid.RowDefinitions>
            <views:VideoDetailSummaryView Grid.Row="0" />
            <Grid Grid.Row="1"
                  Margin="10"
                  RowDefinitions="*,40">
                <views:VideoDetailSelectionView Grid.Row="0" />
                <views:VideoDetailActionsView Grid.Row="1" Margin="0,10,0,0" />
            </Grid>
        </Grid>

        <Image
            Grid.Row="2"
            Width="256"
            Height="256"
            Source="/Resources/no-data.png"
            IsVisible="{Binding UiState.IsEmptyVisible}" />
    </Grid>
</UserControl>
