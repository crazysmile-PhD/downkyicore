<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:asyncImageLoader="clr-namespace:DownKyi.CustomControl.AsyncImageLoader"
    x:Class="DownKyi.Views.VideoDetailSummaryView"
    x:DataType="vm:ViewVideoDetailViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Name="SummaryLayout" ColumnDefinitions="220,*" RowDefinitions="Auto,Auto">
            <Border
                Name="SummaryCover"
                Grid.RowSpan="2"
                Height="172"
                VerticalAlignment="Top"
                Background="{DynamicResource SpaceCarbon}"
                ClipToBounds="True">
                <Image Name="SummaryCoverImage" Stretch="UniformToFill" asyncImageLoader:ImageLoader.Source="{Binding UiState.VideoInfoView.CoverUrl}">
                    <Image.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding CopyCoverUrlCommand}" Header="{DynamicResource CopyCoverUrl}" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
            </Border>
            <StackPanel
                Name="SummaryMetadata"
                Grid.Column="1"
                Margin="24,0,0,0"
                Spacing="8">
                <SelectableTextBlock
                    Name="SummaryTitle"
                    FontSize="26"
                    FontWeight="Bold"
                    Text="{Binding UiState.VideoInfoView.Title}"
                    Foreground="{DynamicResource SpaceInk}"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding UiState.VideoInfoView.Title}" />
                <WrapPanel>
                    <TextBlock Margin="0,0,16,4" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.VideoZone}" />
                    <TextBlock Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.CreateTime}" />
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.PlayNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Play}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.DanmakuNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Danmaku}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.LikeNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Like}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.CoinNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Coin}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.FavoriteNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Favorite}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.ShareNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Share}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{Binding UiState.VideoInfoView.ReplyNumber}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SpaceMuted}" Text="{DynamicResource Reply}" />
                    </StackPanel>
                </WrapPanel>
                <Button
                    Name="NameUp"
                    Classes="studio-back"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Theme="{StaticResource PersonalNavigationButton}"
                    Command="{Binding UpperCommand}"
                    MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="28" Height="28" asyncImageLoader:ImageLoader.Source="{Binding UiState.VideoInfoView.UpHeader}">
                            <Image.Clip>
                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                            </Image.Clip>
                        </Image>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding UiState.VideoInfoView.UpName}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="200" />
                        <TextBlock Text="↗" VerticalAlignment="Center" Foreground="{DynamicResource SpaceMuted}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border
                Name="SummaryDescription"
                Grid.Row="1"
                Grid.Column="1"
                Margin="24,10,0,0">
                <SelectableTextBlock
                    FontSize="12"
                    Foreground="{DynamicResource SpaceMuted}"
                    Text="{Binding UiState.VideoInfoView.Description}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
