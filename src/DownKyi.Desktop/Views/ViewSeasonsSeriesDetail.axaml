<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    xmlns:behavior="clr-namespace:DownKyi.CustomAction"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:vmp="clr-namespace:DownKyi.Presentation"
    xmlns:asyncImageLoader="clr-namespace:DownKyi.CustomControl.AsyncImageLoader"
    x:Class="DownKyi.Views.ViewSeasonsSeriesDetail"
    mc:Ignorable="d"
    d:DesignWidth="840"
    d:DesignHeight="620"
    x:DataType="vm:ViewSeasonsSeriesDetailViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <ControlTheme x:Key="MediaListStyle" TargetType="ListBoxItem" x:DataType="vmp:ChannelMedia">
            <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsSelected" Value="{Binding IsSelected}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <StackPanel Name="nameItemPanel" Background="{TemplateBinding Background}" Margin="0,16,20,12" Cursor="Hand" Orientation="Vertical" Width="208">
                            <Interaction.Behaviors>
                                <DataTriggerBehavior ComparisonCondition="Equal" Binding="{Binding IsSelected}" Value="True">
                                    <ChangePropertyAction TargetObject="nameChecked" PropertyName="IsVisible" Value="True" />
                                </DataTriggerBehavior>
                                <DataTriggerBehavior ComparisonCondition="Equal" Binding="{Binding IsSelected}" Value="False">
                                    <ChangePropertyAction TargetObject="nameChecked" PropertyName="IsVisible" Value="False" />
                                </DataTriggerBehavior>
                            </Interaction.Behaviors>
                            <Border Name="nameCover" Width="208" Height="130" HorizontalAlignment="Center" CornerRadius="0">
                                <Border.Background>
                                    <!--  长宽比：1.6  -->
                                    <ImageBrush
                                        asyncImageLoader:ImageBrushLoader.Source="{Binding Cover}"
                                        asyncImageLoader:ImageBrushLoader.Width="190"
                                        asyncImageLoader:ImageBrushLoader.Height="119" />
                                </Border.Background>
                                <Grid Width="208" Height="130">
                                    <ContentControl
                                        Theme="{StaticResource PersonalSelectionMark}"
                                        Name="nameChecked"
                                        Width="24"
                                        Height="24"
                                        Margin="0,10,15,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource SpaceCarbon}" CornerRadius="0">
                                        <TextBlock Name="nameDuration" Padding="6,0" Foreground="{DynamicResource SpaceCream}" Text="{Binding Duration}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Name="MediaTitleLink" Theme="{StaticResource PersonalMediaLink}" Command="{Binding TitleCommand}" AutomationProperties.Name="{Binding Title}" Height="44" Margin="0,10,0,0">
                                <TextBlock
                                    Name="nameTitle"
                                    MaxWidth="208"
                                    Tag="{Binding Bvid}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTip.Tip="{Binding Title}"
                                    FontSize="15"
                                    FontWeight="SemiBold">
                                </TextBlock>
                            </Button>
                            <Grid Margin="0,3,0,0" ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Image Width="11" Height="11" Source="/Resources/play.png" />
                                    <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource SpaceMuted}" Text="{Binding PlayNumber}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Image Width="12" Height="11" Source="/Resources/time.png" />
                                    <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource SpaceMuted}" Text="{Binding CreateTime}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="Background" Value="{DynamicResource SpaceSelection}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,1,*" Margin="24,18,24,20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <Button
                Name="LibraryBackButton"
                Classes="studio-back"
                Theme="{StaticResource PersonalNavigationButton}"
                Command="{Binding BackSpaceCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="8">
                <Grid ColumnDefinitions="24,12,*">
                    <Path
                        Name="BackArrowPath"
                        Width="24"
                        Height="24"
                        Data="{Binding ArrowBack.Data}"
                        Fill="{DynamicResource SpaceInk}"
                        Stretch="Uniform" />
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{DynamicResource SeasonsSeries}" FontSize="24" FontWeight="Bold" />
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="14"
                            Foreground="{DynamicResource SpaceMuted}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button
                Grid.Column="1"
                Classes="studio-back"
                Theme="{StaticResource PersonalNavigationButton}"
                Width="44"
                Height="44"
                Margin="16,0,0,0"
                Command="{Binding DownloadManagerCommand}"
                ToolTip.Tip="{DynamicResource DownloadManager}">
                <Path
                    Name="DownloadManagePath"
                    Width="24"
                    Height="24"
                    Data="{Binding DownloadManage.Data}"
                    Fill="{DynamicResource SpaceInk}"
                    Stretch="Uniform" />
            </Button>
        </Grid>
        <TextBlock Grid.Row="1" Background="{DynamicResource SpaceRule}" />
        <Grid Grid.Row="2" RowDefinitions="*,1,Auto" Margin="0,8,0,0">
            <ListBox
                x:Name="NameMedias"
                Grid.Row="0"
                BorderThickness="0"
                ItemsSource="{Binding Medias}"
                ItemContainerTheme="{StaticResource MediaListStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Multiple"
                Background="Transparent">
                <Interaction.Behaviors>
                    <behavior:InfiniteScrollBehavior LoadMoreCommand="{Binding LoadMoreCommand}" />
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction Command="{Binding MediasCommand}" CommandParameter="{Binding ElementName=NameMedias, Path=SelectedItems}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Theme>
                    <ControlTheme TargetType="ListBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBox">
                                    <Border
                                        x:Name="Bd"
                                        Padding="0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </ControlTheme>
                </ListBox.Theme>
            </ListBox>
            <!--  加载gif  -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                IsVisible="{Binding LoadingVisibility}">
                <custom:Loading Width="40" Height="40" Foreground="{DynamicResource SpaceAccent}" IsActive="{Binding Loading}" />
                <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{DynamicResource SpaceInk}" Text="{DynamicResource PublicationWait}" />
            </StackPanel>
            <!--  没有数据提示  -->
            <ContentControl Theme="{StaticResource StudioEmptyState}" Grid.Row="0" IsVisible="{Binding NoDataVisibility}" />
            <TextBlock Grid.Row="1" Background="{DynamicResource SpaceRule}" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Name="LibraryToolbar" RowDefinitions="Auto,48" Margin="0,8,0,0">
                <CheckBox
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding SelectAllCommand}"
                    CommandParameter="{Binding ElementName=NameMedias, Path=SelectedItem}"
                    Content="{DynamicResource SelectAll}"
                    Foreground="{DynamicResource SpaceInk}"
                    IsChecked="{Binding IsSelectAll, Mode=TwoWay}"
                    Grid.Row="1" />
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Grid.ColumnSpan="4">
                    <custom:Loading
                        x:Name="LoadMoreIndicator"
                        Width="24"
                        Height="24"
                        Foreground="{DynamicResource SpaceAccent}"
                        IsActive="{Binding Loading}"
                        IsVisible="{Binding LoadingMoreVisibility}" />
                    <StackPanel
                        x:Name="DownloadPreparationStatusPanel"
                        Orientation="Horizontal"
                        Spacing="10"
                        IsVisible="{Binding DownloadCommandGate.IsExecuting}">
                        <custom:DownloadPreparationStatus CancelCommand="{Binding CancelDownloadPreparationCommand}" IsActive="{Binding DownloadCommandGate.IsExecuting}" />
                        <TextBlock
                            x:Name="DownloadPreparationProgressText"
                            MaxWidth="220"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SpaceMuted}"
                            Text="{Binding DownloadPreparationProgressText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding AddToDownloadCommand}"
                    Content="{DynamicResource DownloadSelectedPublication}"
                    FontSize="12"
                    Classes="studio-primary"
                    Grid.Row="1" />
                <Button
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding AddAllToDownloadCommand}"
                    Content="{DynamicResource DownloadAllPublication}"
                    FontSize="12"
                    Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
