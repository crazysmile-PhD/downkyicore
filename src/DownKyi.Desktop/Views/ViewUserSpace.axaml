<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    xmlns:vm="clr-namespace:DownKyi.ViewModels"
    xmlns:vmu="clr-namespace:DownKyi.ViewModels.UserSpace"
    xmlns:asyncImageLoader="clr-namespace:DownKyi.CustomControl.AsyncImageLoader"
    mc:Ignorable="d"
    d:DesignWidth="840"
    d:DesignHeight="620"
    x:Class="DownKyi.Views.ViewUserSpace"
    x:DataType="vm:ViewUserSpaceViewModel"
    Classes="studio-page">
    <UserControl.Styles>
        <StyleInclude Source="/Themes/Styles/Studio.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <ControlTheme x:Key="TabLeftBannerStyle" TargetType="ListBoxItem" x:DataType="vmu:TabLeftBanner">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <ControlTemplate x:DataType="vmu:TabLeftBanner">
                    <Border Padding="12,6" Cursor="Hand" Background="{TemplateBinding Background}">
                        <StackPanel x:Name="panel" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MinHeight="36">
                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <TextBlock Padding="5,0">
                                    <ContentControl Width="20" Height="20" VerticalAlignment="Center">
                                        <Path Width="20" Height="20" Data="{Binding Icon.Data}" Fill="{DynamicResource SpaceInk}" Stretch="Uniform" />
                                    </ContentControl>
                                </TextBlock>
                                <TextBlock Name="nameText" Padding="5,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" />
                            </StackPanel>
                            <TextBlock Name="nameIndicator" Height="1.5" Background="{DynamicResource SpaceInk}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ TextBlock#nameText">
                <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#nameIndicator">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:pointerover /template/ TextBlock#nameText">
                <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            </Style>
            <Style Selector="^:selected /template/ TextBlock#nameText">
                <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            </Style>
            <Style Selector="^:selected /template/ TextBlock#nameIndicator">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="Background" Value="{DynamicResource SpaceSelection}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="TabRightBannerStyle" TargetType="ListBoxItem" x:DataType="vmu:TabRightBanner">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="12,6" Cursor="Hand" Background="{TemplateBinding Background}">
                        <StackPanel x:Name="panel" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MinHeight="36">
                            <TextBlock
                                Name="nameLabel"
                                Padding="0,0,0,5"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource SpaceMuted}"
                                Text="{Binding Label}" />
                            <TextBlock
                                Name="nameCount"
                                Padding="0,0,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource SpaceInk}"
                                Text="{Binding Count}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ TextBlock#nameLabel">
                <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            </Style>
            <Style Selector="^:pointerover /template/ TextBlock#nameCount">
                <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SpaceHover}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="Background" Value="{DynamicResource SpaceSelection}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="TabBannerStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        x:Name="Bd"
                        Padding="0"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>
    <Grid Margin="24,18,24,20" RowDefinitions="Auto,1,Auto,Auto,*">
        <Button
            Classes="studio-back"
            Theme="{StaticResource PersonalNavigationButton}"
            Command="{Binding BackSpaceCommand}"
            HorizontalAlignment="Left"
            Margin="0,0,0,16"
            Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Theme="{StaticResource NavigationIcon.ArrowBack}" Width="24" Height="24" Fill="{DynamicResource SpaceInk}" />
                <TextBlock Text="{DynamicResource UserSpace}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
        </Button>
        <Border Grid.Row="1" Background="{DynamicResource SpaceInk}" />
        <Grid
            Name="CreatorIdentity"
            Grid.Row="2"
            Margin="0,18,0,16"
            ColumnDefinitions="72,*,24,220"
            IsVisible="{Binding ViewVisibility}">
            <Image Width="56" Height="56" VerticalAlignment="Top" asyncImageLoader:ImageLoader.Source="{Binding Header}" />
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="{Binding UserName}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <WrapPanel Orientation="Horizontal">
                    <Image Width="18" Height="18" Source="{Binding Sex}" Margin="0,0,8,0" />
                    <Image Width="28" Height="16" Source="{Binding Level}" Margin="0,0,12,0" />
                    <TextBlock
                        Text="{Binding VipType}"
                        IsVisible="{Binding VipTypeVisibility}"
                        Foreground="{DynamicResource SpaceMuted}"
                        Margin="0,0,12,0" />
                    <TextBlock Text="{Binding IsFollowed}" Foreground="{DynamicResource SpaceMuted}" />
                </WrapPanel>
                <TextBlock
                    Text="{Binding Sign}"
                    Foreground="{DynamicResource SpaceMuted}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Sign}" />
            </StackPanel>
            <Border Name="CreatorArtwork" Grid.Column="3" Height="104" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush asyncImageLoader:ImageBrushLoader.Source="{Binding Background}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>
        <Grid
            Name="CreatorNavigation"
            Grid.Row="3"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            Margin="0,0,0,12"
            IsVisible="{Binding ContentVisibility}">
            <ListBox
                Name="NameTabLeftBanners"
                ItemsSource="{Binding TabLeftBanners}"
                ItemContainerTheme="{StaticResource TabLeftBannerStyle}"
                Theme="{StaticResource PersonalTabs}"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction
                            Command="{Binding TabLeftBannersCommand}"
                            CommandParameter="{Binding ElementName=NameTabLeftBanners, Path=SelectedItem}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </ListBox>
            <ListBox
                Name="NameTabRightBanners"
                ItemsSource="{Binding TabRightBanners}"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                Theme="{StaticResource PersonalTabs}"
                ItemContainerTheme="{StaticResource TabRightBannerStyle}"
                SelectedIndex="{Binding SelectedRightBanner}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Grid.Column="1">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction
                            Command="{Binding TabRightBannersCommand}"
                            CommandParameter="{Binding ElementName=NameTabRightBanners, Path=SelectedItem}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </ListBox>
        </Grid>
        <ContentControl Name="CreatorContent" Grid.Row="4" Content="{Binding RegionContent}" IsVisible="{Binding ContentVisibility}" />
        <StackPanel
            Grid.Row="2"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            IsVisible="{Binding LoadingVisibility}">
            <custom:Loading Width="40" Height="40" Foreground="{DynamicResource SpaceAccent}" IsActive="{Binding Loading}" />
            <TextBlock Text="{DynamicResource UserSpaceWait}" Foreground="{DynamicResource SpaceMuted}" />
        </StackPanel>
        <ContentControl Grid.Row="2" Grid.RowSpan="3" Theme="{StaticResource StudioEmptyState}" IsVisible="{Binding NoDataVisibility}" />
    </Grid>
</UserControl>
