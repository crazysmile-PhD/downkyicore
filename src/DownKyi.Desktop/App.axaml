<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DownKyi.ViewModels"
             xmlns:views="using:DownKyi.Views"
             xmlns:downloadVm="using:DownKyi.ViewModels.DownloadManager"
             xmlns:downloadViews="using:DownKyi.Views.DownloadManager"
             xmlns:friendsVm="using:DownKyi.ViewModels.Friends"
             xmlns:friendsViews="using:DownKyi.Views.Friends"
             xmlns:settingsVm="using:DownKyi.ViewModels.Settings"
             xmlns:settingsViews="using:DownKyi.Views.Settings"
             xmlns:toolboxVm="using:DownKyi.ViewModels.Toolbox"
             xmlns:toolboxViews="using:DownKyi.Views.Toolbox"
             xmlns:userSpaceVm="using:DownKyi.ViewModels.UserSpace"
             xmlns:userSpaceViews="using:DownKyi.Views.UserSpace"
             x:Class="DownKyi.App">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Startup fallback; DesktopLanguageController replaces it before views are created. -->
                <ResourceInclude Source="/Languages/zh-CN.axaml" />
                <ResourceInclude Source="/Themes/DesignTokens.axaml" />
                <ResourceInclude Source="/Themes/ThemeDefault.axaml" />
                <ResourceInclude Source="/Resources/Bilibili/ZoneImages.axaml" />
                <ResourceInclude Source="/Resources/Bilibili/BilibiliImages.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="DefaultFont">Segoe UI Variable Text,Segoe UI,Microsoft JhengHei UI,Microsoft YaHei UI,苹方-简,$Default</FontFamily>
            <FontFamily x:Key="ProgramFont">Segoe UI Variable Text,Segoe UI,Microsoft JhengHei UI,Microsoft YaHei UI,苹方-简,$Default</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:IndexViewModel"><views:ViewIndex /></DataTemplate>
        <DataTemplate DataType="vm:LoginViewModel"><views:ViewLogin /></DataTemplate>
        <DataTemplate DataType="vm:VideoDetailViewModel"><views:ViewVideoDetail /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:ViewSettings /></DataTemplate>
        <DataTemplate DataType="vm:ToolboxViewModel"><views:ViewToolbox /></DataTemplate>
        <DataTemplate DataType="vm:DownloadManagerViewModel"><views:ViewDownloadManager /></DataTemplate>
        <DataTemplate DataType="vm:PublicFavoritesViewModel"><views:ViewPublicFavorites /></DataTemplate>
        <DataTemplate DataType="vm:UserSpaceViewModel"><views:ViewUserSpace /></DataTemplate>
        <DataTemplate DataType="vm:PublicationViewModel"><views:ViewPublication /></DataTemplate>
        <DataTemplate DataType="vm:SeasonsSeriesDetailViewModel"><views:ViewSeasonsSeriesDetail /></DataTemplate>
        <DataTemplate DataType="vm:FriendsViewModel"><views:ViewFriends /></DataTemplate>
        <DataTemplate DataType="vm:MySpaceViewModel"><views:ViewMySpace /></DataTemplate>
        <DataTemplate DataType="vm:MyFavoritesViewModel"><views:ViewMyFavorites /></DataTemplate>
        <DataTemplate DataType="vm:MyBangumiFollowViewModel"><views:ViewMyBangumiFollow /></DataTemplate>
        <DataTemplate DataType="vm:MyToViewVideoViewModel"><views:ViewMyToViewVideo /></DataTemplate>
        <DataTemplate DataType="vm:MyHistoryViewModel"><views:ViewMyHistory /></DataTemplate>
        <DataTemplate DataType="downloadVm:DownloadingViewModel"><downloadViews:ViewDownloading /></DataTemplate>
        <DataTemplate DataType="downloadVm:DownloadFinishedViewModel"><downloadViews:ViewDownloadFinished /></DataTemplate>
        <DataTemplate DataType="friendsVm:FollowingViewModel"><friendsViews:ViewFollowing /></DataTemplate>
        <DataTemplate DataType="friendsVm:FollowerViewModel"><friendsViews:ViewFollower /></DataTemplate>
        <DataTemplate DataType="settingsVm:BasicViewModel"><settingsViews:ViewBasic /></DataTemplate>
        <DataTemplate DataType="settingsVm:NetworkViewModel"><settingsViews:ViewNetwork /></DataTemplate>
        <DataTemplate DataType="settingsVm:VideoViewModel"><settingsViews:ViewVideo /></DataTemplate>
        <DataTemplate DataType="settingsVm:DanmakuViewModel"><settingsViews:ViewDanmaku /></DataTemplate>
        <DataTemplate DataType="settingsVm:AboutViewModel"><settingsViews:ViewAbout /></DataTemplate>
        <DataTemplate DataType="toolboxVm:BiliHelperViewModel"><toolboxViews:ViewBiliHelper /></DataTemplate>
        <DataTemplate DataType="toolboxVm:DelogoViewModel"><toolboxViews:ViewDelogo /></DataTemplate>
        <DataTemplate DataType="toolboxVm:ExtractMediaViewModel"><toolboxViews:ViewExtractMedia /></DataTemplate>
        <DataTemplate DataType="userSpaceVm:ArchiveViewModel"><userSpaceViews:ViewArchive /></DataTemplate>
        <DataTemplate DataType="userSpaceVm:UserSpaceSeasonsSeriesViewModel"><userSpaceViews:ViewUserSpaceSeasonsSeries /></DataTemplate>
        <DataTemplate DataType="userSpaceVm:FavoritesViewModel"><userSpaceViews:ViewFavorites /></DataTemplate>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="/Themes/Styles/loading.axaml" />
        <StyleInclude Source="/Themes/Styles/download-preparation-status.axaml" />
        <StyleInclude Source="/Themes/Styles/StudioChrome.axaml" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
            <Setter Property="Background" Value="{DynamicResource SpacePaper}" />
            <Setter Property="Foreground" Value="{DynamicResource SpaceInk}" />
        </Style>
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="{DynamicResource ProgramFont}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="{DynamicResource DownKyiControlMinHeight}" />
            <Setter Property="CornerRadius" Value="{DynamicResource DownKyiRadiusSmall}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSunken}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlStrokeFocus}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="{DynamicResource DownKyiControlMinHeight}" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="CornerRadius" Value="{DynamicResource DownKyiRadiusSmall}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSunken}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushControlStrokeFocus}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushControlFillHover}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource BrushSelectionFill}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="{DynamicResource DownKyiProgressThickness}" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
        </Style>
        <Style Selector="HeaderedContentControl">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource DownKyiFontSizeBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                            <Border
                                ZIndex="1"
                                CornerRadius="{DynamicResource DownKyiRadiusMedium}"
                                Padding="{DynamicResource DownKyiHeaderPadding}"
                                Background="{DynamicResource BrushSurfaceBase}"
                                Margin="{DynamicResource DownKyiHeaderMargin}">
                                <TextBlock
                                    Text="{TemplateBinding Header}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource DownKyiRadiusMedium}">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Styles>
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Resources/favicon.ico" ToolTipText="{DynamicResource AppName}" />
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
