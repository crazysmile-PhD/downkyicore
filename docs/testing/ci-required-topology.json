{
  "schemaVersion": 1,
  "repositoryShardCount": 2,
  "repositoryMaxParallelProjects": 2,
  "reviewMutationShardCount": 4,
  "lanes": [
    {
      "platform": "Windows",
      "runner": "windows-latest"
    },
    {
      "platform": "Linux",
      "runner": "ubuntu-latest"
    },
    {
      "platform": "macOS",
      "runner": "macos-latest"
    }
  ],
  "builds": [
    {
      "platform": "Windows",
      "configuration": "Release"
    },
    {
      "platform": "Linux",
      "configuration": "Release"
    },
    {
      "platform": "macOS",
      "configuration": "Release"
    },
    {
      "platform": "Windows",
      "configuration": "Debug"
    }
  ],
  "lifecycle": {
    "platform": "Windows",
    "runner": "windows-latest",
    "gateAuthorityAssembly": "DownKyi.Architecture.Tests",
    "profiles": {
      "PR": 3,
      "Main": 5
    },
    "phases": [
      "load",
      "assembly-info",
      "discovery",
      "execution",
      "assembly-teardown",
      "process-exit"
