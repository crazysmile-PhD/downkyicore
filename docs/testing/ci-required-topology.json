    "gateResults": [
      {
        "assembly": "Gate.Forensics",
        "phase": "forensics-self-test"
      },
      {
        "assembly": "Gate.ProcessLease",
        "phase": "owned-tree-self-test"
      },
      {
        "assembly": "Gate.MarkerReader",
        "phase": "marker-reader-self-test"
      }
    ]
  },
  "requiredUpstreamJobs": [
    "release-build",
    "debug-build",
    "repository-suite",
    "review-mutations",
    "assembly-lifecycle",
    "format",
    "aria2-tls-security",
    "package-audit"
  ]
}
